APP_NAME=Fluentian API
ENV=dev
DATABASE_URL=sqlite+aiosqlite:///./fluentian.db
JWT_SECRET_KEY=change-me-super-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:3000,http://10.0.2.2:8000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
LOG_LEVEL=INFO
REQUEST_ID_HEADER=X-Request-ID
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
AI_CONTEXT_TURN_LIMIT=12
REDIS_URL=redis://localhost:6379/0
REDIS_QUEUE_KEY=fluentian:match:queue
REDIS_PRESENCE_PREFIX=fluentian:presence
REDIS_USER_EVENTS_PREFIX=fluentian:events:user
REDIS_SESSION_PREFIX=fluentian:session
REDIS_SESSION_TTL_SECONDS=3600
ALLOW_CROSS_BASE_LANGUAGE_MATCHING=true
MATCHMAKING_LOOP_ENABLED=true
MATCHMAKING_LOOP_INTERVAL_SECONDS=2
HEARTBEAT_TIMEOUT_SECONDS=15
RECORDING_RETENTION_HOURS=24
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
